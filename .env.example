# Set to the final company website origin before deployment.
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# Public Storefront API; tokenless browsing and cart work on the current store.
SHOPIFY_STORE_DOMAIN=krtymq-v4.myshopify.com
# Optional public Storefront token (never use an Admin API token).
SHOPIFY_STOREFRONT_TOKEN=
# Server-only credentials for an installed Shopify app with read_products and read_inventory.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Alternative for an existing non-expiring Admin API token.
SHOPIFY_ADMIN_ACCESS_TOKEN=
# Enable only after the domain migration, inventory integration and SEO audit.
SHOP_SEO_LIVE=false

# LXP Luper — server-only. Enable after API and budget storage are configured.
OPENAI_API_KEY=
LUPER_ENABLED=false
# Exact public origin; omit for local development.
LUPER_SITE_ORIGIN=
# Production requires an Upstash-compatible Redis REST database (atomic EVAL).
# Development uses an ignored, persistent .luper-data/ ledger instead.
LUPER_REDIS_REST_URL=
LUPER_REDIS_REST_TOKEN=
